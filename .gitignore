# Dependencies
node_modules/

# Secrets (API keys, login cookies) - never commit
.env
.env.*
!.env.example

# Generated files (videos, audio, slides)
output/
# Channel images exported by npm run assets (their sources in assets/ are committed)
assets/*.png

# Paper figures are copyrighted - keep them local (the demo episode's placeholders are ours)
figures/
!episodes/example/figures/

# Logs
logs/
*.log

# Claude Code local settings
.claude/settings.local.json
